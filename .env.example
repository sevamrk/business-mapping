# Every setting below has a working default. A fresh clone runs with none of
# them set, and there is nothing here to sign up for.

# The map to read. A relative path resolves against the repository root, so the
# bundled example works from anywhere.
FUNCTION_MAP_PATH=examples/harbourgate-coffee.json

# Working hours behind one full-time person, used to turn recovered hours into
# headcount. 1600 is a European year after holiday and sick leave. Change it to
# whatever your finance team already uses, or the number will start an argument
# about the wrong thing.
HOURS_PER_FTE_YEAR=1600

# How many rows `main.py rank` prints. 0 means all of them.
RANK_LIMIT=15
